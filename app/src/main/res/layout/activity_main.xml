<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Permissions / status console (text + colour set in renderStatus) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0D000000"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView android:id="@+id/status_overlay"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true"
                android:paddingVertical="8dp" android:textSize="15sp" />
            <TextView android:id="@+id/status_accessibility"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true"
                android:paddingVertical="8dp" android:textSize="15sp" />
            <TextView android:id="@+id/status_lock"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:focusable="true"
                android:paddingVertical="8dp" android:textSize="15sp" />
        </LinearLayout>

        <!-- Active timers (lockdown / unlock window / strict week) -->
        <TextView android:id="@+id/status_active"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Mode dropdown, directly under permissions -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Mode:" android:textSize="15sp" android:paddingEnd="8dp" />
            <Spinner android:id="@+id/spinner_mode"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Buttons, Report first -->
        <Button android:id="@+id/btn_report"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Report" />
        <Button android:id="@+id/btn_recent_blocks"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Recent blocks" />
        <Button android:id="@+id/btn_strict_week"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Start week-long strict mode" />
        <Button android:id="@+id/btn_clear_blocks"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/clear_blocks" />
        <Button android:id="@+id/btn_ban_list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Manage blocks" />
        <Button android:id="@+id/btn_view_log"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="View log" />
        <Button android:id="@+id/btn_stats"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="View statistics" />
        <Button android:id="@+id/btn_about"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="About &amp; privacy" />
    </LinearLayout>
</ScrollView>
