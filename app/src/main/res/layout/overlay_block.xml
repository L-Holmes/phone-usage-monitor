<?xml version="1.0" encoding="utf-8"?>
<!--
  The block cover.

  Order: what happened (Blocked / why) -> the way out (big) -> the quiet alternative.

  "Go back one page instead" is deliberately small. Back inside a browser is unpredictable -
  it can dump you on another blocked page, or somewhere you never asked for. The app itself
  NEVER presses Back for you; it only happens if you tap that link. It is also HIDDEN
  entirely unless the block is a distracting web page in a browser (OverlayController.show's
  showGoBack) - a blocked app or a sensor cover (lying down / dark / protected room) has no
  page to go back to.

  block_status is EMPTY by default and stays that way. It is only ever filled in - and
  flashed - when the user actually taps Go back, so it can tell them whether Back moved them
  anywhere. It must never appear on its own.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_cover"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/block_title"
        android:textColor="@color/ds_cover_text"
        android:letterSpacing="-0.02"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/block_explanation"
        android:textColor="@color/ds_cover_text_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/block_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/ds_cover_reason"
        android:textSize="18sp" />

    <!-- Only ever set after the user taps "Go back". Empty otherwise. -->
    <TextView
        android:id="@+id/block_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alpha="0"
        android:gravity="center"
        android:textColor="@color/ds_tint"
        android:textSize="14sp" />

    <!-- PRIMARY: the way out. -->
    <Button
        android:id="@+id/btn_leave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/block_primary_button"
        android:minHeight="76dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:text="@string/leave"
        android:textAllCaps="false"
        android:textColor="@color/ds_on_fill"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- SECONDARY: quiet, optional, never automatic. -->
    <TextView
        android:id="@+id/btn_go_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:text="@string/go_back"
        android:textColor="@color/ds_cover_text_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btn_report"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:text="@string/report_block"
        android:textColor="@color/ds_label_tertiary"
        android:textSize="13sp" />

</LinearLayout>
