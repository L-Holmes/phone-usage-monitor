<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ═══ THE STAND-IN GUARD (MonitorGuardService, see SettingsGuard.kt) ═══════════
         Switching "page monitoring" off in Settings destroys our accessibility service
         outright, and nothing in that file can run afterwards. These four permissions are
         what lets an ordinary foreground service take over until the switch goes back on.

         PACKAGE_USAGE_STATS is signature|appop: declaring it does NOT grant it, it only
         makes the app appear in Settings -> Special access -> Usage access, where the user
         grants it by hand. Without it the stand-in cannot tell what app is in front, so it
         covers nothing and only nags - see MonitorFallback.hasUsageAccess.

         RECEIVE_BOOT_COMPLETED matters because a reboot with monitoring already off is a
         gap the accessibility service cannot close for itself: nothing of ours would run. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.INTERNET"/> <!-- used for loading in the banned urls list. -->

    <!-- Room beacons (KKM K11, see RoomBeacons.kt). BLUETOOTH_SCAN deliberately has NO
         android:usesPermissionFlags="neverForLocation": with that flag Android 12+
         silently strips beacon frames out of scan results, which is our entire signal.
         Because we scan without it, fine location must be declared (and granted) too. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <!-- Location is also read directly (GPS/network) for the home-area check - "is the
         phone within 50 m of the house?" - see HomeArea.kt. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- "Allow all the time". The home-area answer has to stay current with no activity
         on screen (HomeAreaWatch runs inside the accessibility service), and from Android
         10 that needs this separate grant. It must also be REQUESTED separately, after
         fine location - asking for both in one call makes Android 11+ grant neither.
         From Android 11 the runtime dialog no longer offers it at all, so the dev page
         also deep-links to the app's location settings. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Lets us detect installed browsers at runtime (see AppBlocklist.refresh).
         This is a visibility declaration, not a permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- The setup gate has to be able to SEE whether Firefox is installed (BrowserSetup),
             and package visibility is filtered from Android 11 on. Keep in step with
             AppConfig.FIREFOX_PACKAGES. -->
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.fenix" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.WebTrafficMonitor">

        <!-- Persists the user's in-app language choice (AppCompatDelegate.setApplicationLocales)
             on Android 12 and below; on 13+ the OS stores it. See LocaleHelper. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads the foreground app, address-bar domain, page title and on-screen text. -->
        <service
            android:name=".PageMonitorAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- The stand-in guard: runs ONLY while page monitoring is off, and stops itself
             the moment it is back on. specialUse because none of Android 14's foreground
             service types describes "keep enforcing a self-imposed block while the user's
             own accessibility service is disabled" - it is not dataSync, health, or any of
             the rest, and claiming one of those would be a false declaration. -->
        <service
            android:name=".MonitorGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Restores self-imposed content blocking after the user's own accessibility service is switched off" />
        </service>

        <!-- A reboot while monitoring is off would otherwise leave nothing of ours running. -->
        <receiver
            android:name=".GuardBootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Prevent user from uninstall -->
        <receiver
            android:name=".UninstallGuardAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>
